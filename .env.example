# Agent Control Plane — environment template.
# Copy to .env and fill in. NEVER commit .env, and never put real secrets here.
# All values below are placeholders for local development.

# ---- Postgres (docker compose service: postgres) ----
POSTGRES_USER=acp
POSTGRES_PASSWORD=CHANGE_ME__dev_only_password
POSTGRES_DB=acp
POSTGRES_PORT=5432

# ---- Redis (docker compose service: redis) ----
REDIS_PORT=6379

# ---- Primary database / cache URLs used by api + worker ----
# Compose services resolve via service names; override for external hosts.
DATABASE_URL=postgresql+psycopg://acp:CHANGE_ME__dev_only_password@postgres:5432/acp
REDIS_URL=redis://redis:6379/0

# ---- API auth ----
# Bearer API key for /api/v1. Placeholder ONLY — generate a real one per deploy.
# Example: python -c "import secrets; print(secrets.token_urlsafe(32))"
ACP_API_KEY=dev-placeholder-key-REPLACE-ME

# ---- API port (host mapping) ----
ACP_API_PORT=8000

# ---- OPA (governance profile only: docker compose --profile governance up) ----
# When set, the API uses OPA as the policy decision point. When unset, the
# minimal built-in evaluator is used (local dev ONLY — not production auth).
OPA_URL=http://opa:8181
OPA_PORT=8181

# ---- Observability (optional) ----
# OTLP endpoint for OpenTelemetry export (e.g. http://otel-collector:4317).
# Leave empty to log traces locally only.
OTEL_EXPORTER_OTLP_ENDPOINT=

# ---- Logging ----
# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# ---- Multi-tenancy ----
# Default tenant when X-Tenant-ID header is absent (dev convenience only;
# production deployments should require the header).
TENANT_DEFAULT=default
